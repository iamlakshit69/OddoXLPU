PORT=4000
NODE_ENV=production
DB_HOST=your-railway-mysql-host
DB_PORT=3306
DB_NAME=stocksense
DB_USER=root
DB_PASSWORD=change-me
JWT_SECRET=change-this-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=10

# Your deployed Vercel frontend URL (no trailing slash)
FRONTEND_URL=https://your-app.vercel.app

# ---- Email (OTP delivery) -------------------------------------------------
# Leave EMAIL_USER blank to disable real email — OTP will be printed to console.
# Gmail: create an App Password at myaccount.google.com → Security → App Passwords
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password
# Optional — use these instead of EMAIL_SERVICE for custom SMTP (SendGrid, Mailgun, etc.):
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_SECURE=false
